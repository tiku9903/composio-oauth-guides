# Copy to .env and fill in. Never commit .env (it is git-ignored).

# --- Model (free by default) ---
# Google Gemini free tier. Get a key at https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=
MODEL=google_genai:gemini-3.8-flash
FAST_MODEL=google_genai:gemini-3.5-flash-lite
# If a model name is rejected, pick another free one listed at https://ai.google.dev/gemini-api/docs/pricing

# Paid alternatives (set MODEL/FAST_MODEL and the matching key instead):
# MODEL=anthropic:claude-sonnet-5-5   FAST_MODEL=anthropic:claude-haiku-5-5   ANTHROPIC_API_KEY=
# MODEL=openai:gpt-5                  FAST_MODEL=openai:gpt-5-mini            OPENAI_API_KEY=

# --- Web search (free tier) ---
# https://app.tavily.com. Without it DuckDuckGo is used, which is often blocked from cloud servers.
TAVILY_API_KEY=

# --- Optional ---
# Lets the agent read Composio's authoritative managed-auth status for a toolkit.
COMPOSIO_API_KEY=

# Tuning (defaults shown). Keep EXTRACT_CONCURRENCY low on free model tiers.
# EXTRACT_CONCURRENCY=2
# MAX_PAGES=10
# GUIDE_CACHE_DAYS=7
