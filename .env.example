# Copy to .env and fill in. Never commit .env.

# Model for the live agent (LangChain "provider:model"). Default is Anthropic.
MODEL=anthropic:claude-sonnet-5-5
# Cheaper model used for page fact-extraction and app identification.
FAST_MODEL=anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=
# To use OpenAI instead: MODEL=openai:gpt-5  FAST_MODEL=openai:gpt-5-mini  OPENAI_API_KEY=...
# OPENAI_API_KEY=

# Web search. Recommended: Tavily (free tier is enough for demos). Without it, DuckDuckGo is used,
# which works but is rate-limited from cloud IPs.
TAVILY_API_KEY=

# Optional: lets the agent read Composio's authoritative `composio_managed_auth_schemes`
# for a toolkit instead of inferring it from the public docs page.
COMPOSIO_API_KEY=

# Tuning (defaults shown)
# MAX_PAGES=10
# MAX_SEARCH_RESULTS=6
# GUIDE_CACHE_DAYS=7
